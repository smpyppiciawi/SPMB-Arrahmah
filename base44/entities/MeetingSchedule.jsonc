{
  "name": "MeetingSchedule",
  "type": "object",
  "properties": {
    "meeting_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal rapat"
    },
    "meeting_name": {
      "type": "string",
      "description": "Nama rapat"
    },
    "meeting_time": {
      "type": "string",
      "description": "Jam pelaksanaan"
    }
  },
  "required": [
    "meeting_date",
    "meeting_name",
    "meeting_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}